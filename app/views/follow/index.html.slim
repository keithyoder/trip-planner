- content_for :title, t('follow.page_title')
= render 'follow/header', current: :days

main.main.wrap#dias
  .title-row
    div
      p.eyebrow = t('follow.eyebrow')
      h1.h1 = t('follow.title')

  section.card.summary aria-label=t('follow.eyebrow')
    = render 'welcome/map', overview: @overview, map: @map
    div
      = render 'welcome/stats', overview: @overview
      .now
        = link_to t('follow.live_dashboard'), dashboard_path, class: 'btn btn-primary btn-sm', data: { turbo: false }

  section.group aria-label=t('follow.title')
    - if @days.earlier
      = link_to follow_path(day: @days.earlier), class: 'pager pager-up', rel: 'prev' do
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          path d="M6 15l6-6 6 6"
        = t('follow.earlier_days')
    ul.days
      - @days.days.each do |day|
        li = render 'follow/day', day: day
    - if @days.later
      = link_to follow_path(day: @days.later), class: 'pager pager-down', rel: 'next' do
        = t('follow.later_days')
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          path d="M6 9l6 6 6-6"
