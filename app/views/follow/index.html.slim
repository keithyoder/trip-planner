- content_for :title, t('follow.page_title')
= render 'follow/header', current: :days

main.main.wrap#dias
  .title-row
    div
      p.eyebrow = t('follow.eyebrow')
      h1.h1 = t('follow.title')

  section.card.summary aria-label=t('follow.eyebrow')
    = render 'welcome/map', overview: @overview, map: @map
    div
      = render 'welcome/stats', overview: @overview
      .now
        = link_to t('follow.live_dashboard'), dashboard_path, class: 'btn btn-primary btn-sm', data: { turbo: false }

  - @days.groups.each do |group|
    section.group
      .group-head
        h2.h2 = group.country
        span.small.muted = "#{group.days.size} #{t('follow.later_days')}"
      ul.days
        - group.days.each do |day|
          li = render 'follow/day', day: day

  - if @days.later.any?
    section.group
      .group-head
        h2.h2 = t('follow.later')
      ul.later
        - @days.later.each do |later|
          li
            strong = later.country
            span.small.muted = "#{later.total} #{t('follow.later_days')}"
