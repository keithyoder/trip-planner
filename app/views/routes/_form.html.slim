= form_with(model: [@trip, route]) do |form|
  - if route.errors.any?
    .alert.alert-danger role="alert"
      h4.alert-heading
        = pluralize(route.errors.count, "error")
        |  prohibited this route from being saved:
      ul.mb-0
        - route.errors.each do |error|
          li
            = error.full_message

  .mb-3
    = form.label :waypoint_start_id, t('routes.form.waypoint_start'), class: 'form-label'
    = form.select :waypoint_start_id, options_for_select(@trip.waypoints.order(:sequence).map { |w| ["#{w.sequence} - #{w.name}", w.id] }, route.waypoint_start_id), { include_blank: false }, class: 'form-select'

  .mb-3
    = form.label :waypoint_end_id, t('routes.form.waypoint_end'), class: 'form-label'
    = form.select :waypoint_end_id, options_for_select(@trip.waypoints.order(:sequence).map { |w| ["#{w.sequence} - #{w.name}", w.id] }, route.waypoint_end_id), { include_blank: false }, class: 'form-select'

  .mb-3
    = form.label :start_time, t('routes.form.start_time'), class: 'form-label'
    .row.g-2
      .col-4
        = form.number_field :start_time_days, value: (route.start_time ? (route.start_time / 86400).to_i : 0), min: 0, class: 'form-control', placeholder: t('common.day.other')
        small.form-text.text-muted = t('common.day.other')
      .col-4
        = form.number_field :start_time_hours, value: (route.start_time ? ((route.start_time % 86400) / 3600).to_i : 0), min: 0, max: 23, class: 'form-control', placeholder: t('common.hour.other')
        small.form-text.text-muted = t('common.hour.other')
      .col-4
        = form.number_field :start_time_minutes, value: (route.start_time ? ((route.start_time % 3600) / 60).to_i : 0), min: 0, max: 59, class: 'form-control', placeholder: t('common.minute.other')
        small.form-text.text-muted = t('common.minute.other')

  .d-grid
    = form.submit t('routes.form.submit'), class: 'btn btn-primary'