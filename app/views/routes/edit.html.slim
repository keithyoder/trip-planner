h1 = t('.title')
/ Flash notice
- if notice
  .alert.alert-success.alert-dismissible.fade.show role="alert"
    = notice
    button.btn-close type="button" data-bs-dismiss="alert" aria-label="Close"

.container[style="max-width: 800px;"]
  = render 'form', route: @route

  br

  .d-flex.justify-content-between.align-items-center
    = link_to t('helpers.links.back'), trip_route_path(@trip, @route), class: 'btn btn-secondary'
    
    = button_to t('routes.edit.calculate_route'), calculate_trip_route_path(@trip, @route), method: :post, class: 'btn btn-primary', data: { confirm: t('routes.edit.calculate_confirm') }
