.container-fluid.py-4
  / Flash notice
  - if notice
    .alert.alert-success.alert-dismissible.fade.show role="alert"
      = notice
      button.btn-close type="button" data-bs-dismiss="alert" aria-label="Close"

  .row
    .col-12
      / Route header
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h1.display-5.fw-bold.mb-1
            i.fa.fa-route.me-2
            = "#{@route.waypoint_start.name} → #{@route.waypoint_end.name}"
          p.text-muted.mb-0 = l(@route.route_sequence.date, format: :long)

        .btn-group role="group"
          = link_to edit_trip_route_path(@route.trip, @route), class: "btn btn-outline-primary" do
            i.bi.bi-pencil-square.me-2
            = t('common.edit')
          = link_to trip_route_overpass_index_path(@route.trip, @route), class: "btn btn-outline-secondary" do
            i.bi.bi-geo-alt.me-2
            = t('routes.show.overpass')
          = link_to trip_routes_path(@route.trip), class: "btn btn-outline-secondary" do
            i.bi.bi-arrow-left.me-2
            = t('routes.show.back_to_routes')

  / Solar information banner
  .row.mb-4
    .col-12
      .card.shadow-sm.bg-dark.text-white
        .card-body.py-2
          .row.g-2.text-center
            .col-6.col-md.border-end.border-secondary
              .d-flex.align-items-center.justify-content-center.gap-2
                i.bi.bi-moon-stars.text-info
                div.text-start
                  small.text-white-50.d-block = t('routes.show.dawn')
                  strong.d-block = @route.waypoint_start.solar_position(@route.route_sequence.date).dawn.strftime("%H:%M")
            .col-6.col-md.border-end.border-secondary
              .d-flex.align-items-center.justify-content-center.gap-2
                i.bi.bi-sunrise.text-warning
                div.text-start
                  small.text-white-50.d-block = t('routes.show.sunrise')
                  strong.d-block = @route.waypoint_start.solar_position(@route.route_sequence.date).sunrise.strftime("%H:%M")
            .col-6.col-md.border-end.border-secondary
              .d-flex.align-items-center.justify-content-center.gap-2
                i.bi.bi-sunset.text-orange
                div.text-start
                  small.text-white-50.d-block = t('routes.show.sunset')
                  strong.d-block = @route.waypoint_end.solar_position(@route.route_sequence.date).sunset.strftime("%H:%M")
            .col-6.col-md.border-end.border-secondary
              .d-flex.align-items-center.justify-content-center.gap-2
                i.bi.bi-moon.text-primary
                div.text-start
                  small.text-white-50.d-block = t('routes.show.dusk')
                  strong.d-block = @route.waypoint_end.solar_position(@route.route_sequence.date).dusk.strftime("%H:%M")
            .col-12.col-md
              .d-flex.align-items-center.justify-content-center.gap-2
                i.bi.bi-sun.text-warning
                div.text-start
                  small.text-white-50.d-block = t('routes.show.day_length')
                  strong.d-block = humanize(@route.waypoint_start.solar_position(@route.route_sequence.date).day_length)

  / Route statistics
  - ferry_dur  = @route.route_sequence.ferry_duration
  - hiking_dur = @route.route_sequence.hiking_duration
  - has_ferry  = ferry_dur&.to_i&.positive?
  - has_hiking = hiking_dur&.to_i&.positive?
  - col_class  = "col-sm-6 col-lg-#{12 / [4, (has_ferry ? 1 : 0) + (has_hiking ? 1 : 0) + 4].max}"

  .row.g-4.mb-4
    div class=col_class
      .card.shadow-sm.h-100
        .card-body.text-center
          i.bi.bi-sign-turn-right.text-primary.fs-1.mb-2
          h6.text-muted.mb-1 = t('routes.show.distance')
          h4.mb-0 = format_distance(@route.route_sequence.distance, decimals: 1)

    div class=col_class
      .card.shadow-sm.h-100
        .card-body.text-center
          i.bi.bi-car-front.text-success.fs-1.mb-2
          h6.text-muted.mb-1 = t('routes.show.driving_time')
          h4.mb-0 = format_duration(@route.route_sequence.driving_duration)

    - if has_ferry
      div class=col_class
        .card.shadow-sm.h-100
          .card-body.text-center
            i.bi.bi-water.text-info.fs-1.mb-2
            h6.text-muted.mb-1 = t('routes.show.ferry_time')
            h4.mb-0 = format_duration(ferry_dur)

    - if has_hiking
      div class=col_class
        .card.shadow-sm.h-100
          .card-body.text-center
            i.bi.bi-person-walking.text-warning.fs-1.mb-2
            h6.text-muted.mb-1 = t('routes.show.hiking_time')
            h4.mb-0 = format_duration(hiking_dur)

    div class=col_class
      .card.shadow-sm.h-100
        .card-body.text-center
          i.bi.bi-pause-circle.text-warning.fs-1.mb-2
          h6.text-muted.mb-1 = t('routes.show.stopped_time')
          h4.mb-0 = format_duration(@route.route_sequence.stopped_time)

    div class=col_class
      .card.shadow-sm.h-100
        .card-body.text-center
          i.bi.bi-hourglass-split.text-info.fs-1.mb-2
          h6.text-muted.mb-1 = t('routes.show.total_time')
          h4.mb-0 = format_duration(@route.route_sequence.total_duration)

  / Map and content
  .row.g-4.mb-4
    .col-lg-7
      .card.shadow-sm.h-100
        .card-header.bg-white.border-bottom
          h5.card-title.mb-0
            i.bi.bi-map.me-2
            = t('routes.show.route_map')
        .card-body.p-0
          - if @route.geom
            - surface_segments_json = @route.surface_segments.map { |s| { surface_type: s.surface_type, category: s.category, points: s.points } }.to_json
            div[
              data-controller="routes"
              data-routes-waypoints-value="#{waypoints_map_data(@route.waypoints)}"
            ]
              #routescontainer.w-100[
                data-routes-target="container"
                style="min-height: 500px; height: 60vh;"
                data-lon="-34.5"
                data-lat="-8.5"
                data-route="#{@route.geom.coordinates.map { |c| [c[1], c[0]] }}"
                data-surface-segments="#{surface_segments_json}"
              ]

    .col-lg-5
      .card.shadow-sm.h-100[
        data-controller="panel-toggle"
        data-panel-toggle-day-plan-label-value=t('routes.show.day_plan')
        data-panel-toggle-directions-label-value=t('routes.show.directions_short')
        data-panel-toggle-locale-value=I18n.locale.to_s
      ]
        .card-header.bg-white.border-bottom.p-1
          .btn-group.btn-group-sm.w-100 role="group"
            button.btn.btn-outline-secondary.flex-fill.fs-6[
              type="button"
              data-action="click->panel-toggle#showDayPlan"
              data-panel="day-plan"
            ]
              i.bi.bi-journal-text.me-1
              = t('routes.show.day_plan')
            button.btn.btn-outline-secondary.flex-fill.fs-6[
              type="button"
              data-action="click->panel-toggle#showDirections"
              data-panel="directions"
            ]
              i.bi.bi-list-ol.me-1
              = t('routes.show.directions_short')

        .card-body.p-0[style="max-height: 60vh; overflow-y: auto;"]
          div[data-panel-toggle-target="dayPlan"]
            = turbo_stream_from "route_#{@route.id}_day_plan"
            = render 'day_plan', route: @route
          div.d-none[data-panel-toggle-target="directions"]
            = render "directions", route: @route, trip: @trip

  / Elevation profile
  .row.mb-4
    .col-12
      .card.shadow-sm
        .card-header.bg-white.border-bottom
          h5.card-title.mb-0
            i.bi.bi-graph-up.me-2
            = t('routes.show.elevation_profile')
        .card-body
          = elevation_chart(@route)
