- presenter = DayPlanPresenter.new(route)

#day-plan-content
  .card.shadow-sm.mb-4 data-controller="clipboard"
    - if presenter.empty?
      .card-body.text-center.py-4
        i.bi.bi-journal-text.text-muted.fs-1.d-block.mb-3
        p.text-muted.mb-0 Add notes to waypoints to build your day plan.

    - else
      .card-header.bg-white.border-bottom.d-flex.justify-content-between.align-items-center
        h5.card-title.mb-0
          i.bi.bi-journal-text.me-2
          = t('routes.show.day_plan')
        button.btn.btn-sm.btn-outline-secondary data-clipboard-target="button" data-action="clipboard#copy"
          i.bi.bi-clipboard.me-1 data-clipboard-target="icon"
          = t('routes.show.copy_for_whatsapp')
      .card-body
        - if presenter.available_locales.size > 1
          ul.nav.nav-tabs.mb-3 role="tablist"
            - presenter.available_locales.each_with_index do |locale, i|
              li.nav-item role="presentation"
                button.nav-link[id="day-plan-tab-#{locale}" data-bs-toggle="tab" data-bs-target="#day-plan-#{locale}" type="button" role="tab" class=("active" if i == 0)]
                  = locale.upcase
          .tab-content
            - presenter.available_locales.each_with_index do |locale, i|
              div[id="day-plan-#{locale}" class="tab-pane fade#{i == 0 ? ' show active' : ''}" role="tabpanel" data-clipboard-target="source" data-content=DayPlanPresenter.new(route, locale: locale).to_whatsapp]
                = MarkdownRenderer.render(DayPlanPresenter.new(route, locale: locale).to_markdown).html_safe
        - else
          div data-clipboard-target="source" data-content=presenter.to_whatsapp
            = MarkdownRenderer.render(presenter.to_markdown).html_safe