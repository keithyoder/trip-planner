- presenter = DayPlanPresenter.new(route)

#day-plan-content
  - if presenter.empty?
    .p-4.text-center
      i.bi.bi-journal-text.text-muted.fs-1.d-block.mb-3
      p.text-muted.mb-0 Add notes to waypoints to build your day plan.
  - else
    div data-controller="clipboard"
      .px-3.pt-3.pb-0
        - if presenter.available_locales.size > 1
          .d-flex.align-items-center.justify-content-between.mb-0
            ul.nav.nav-tabs.border-bottom-0 role="tablist"
              - presenter.available_locales.each_with_index do |locale, i|
                li.nav-item role="presentation"
                  button.nav-link[id="day-plan-tab-#{locale}" data-bs-toggle="tab" data-bs-target="#day-plan-#{locale}" type="button" role="tab" class=("active" if i == 0)]
                    = locale.upcase
            button.btn.btn-sm.btn-outline-secondary data-clipboard-target="button" data-action="clipboard#copy"
              i.bi.bi-clipboard.me-1 data-clipboard-target="icon"
              = t('routes.show.copy_for_whatsapp')
        - else
          .d-flex.justify-content-end.mb-2
            button.btn.btn-sm.btn-outline-secondary data-clipboard-target="button" data-action="clipboard#copy"
              i.bi.bi-clipboard.me-1 data-clipboard-target="icon"
              = t('routes.show.copy_for_whatsapp')
      .px-3.pb-3
        - if presenter.available_locales.size > 1
          .tab-content
            - presenter.available_locales.each_with_index do |locale, i|
              div[id="day-plan-#{locale}" class="tab-pane fade#{i == 0 ? ' show active' : ''}" role="tabpanel" data-clipboard-target="source" data-content=presenter.to_whatsapp(locale: locale)]
                = MarkdownRenderer.render(presenter.to_markdown(locale: locale)).html_safe
        - else
          - locale = presenter.available_locales.first
          div data-clipboard-target="source" data-content=presenter.to_whatsapp(locale: locale)
            = MarkdownRenderer.render(presenter.to_markdown(locale: locale)).html_safe