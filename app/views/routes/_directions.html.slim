- presenter = DirectionsPresenter.new(route)

div[data-controller="directions"]
  - if presenter.has_geometry?
    table.table.table-sm.table-hover.mb-0
      thead.sticky-top.bg-white
        tr
          th.border-0 = t('routes.show.directions')
          th.border-0.text-end = t('routes.show.distance')
          th.border-0.text-end = t('routes.show.speed')
          th.border-0.text-end = t('routes.show.time')

      - presenter.rows.each do |row|
        - segment_id = "seg-#{row.waypoint.sequence}"

        tbody
          tr.collapsed[
            data-bs-toggle="collapse"
            data-bs-target="##{segment_id}"
            style="cursor: pointer; border-left: 3px solid #{waypoint_color(row.waypoint.waypoint_type)}; background-color: #{waypoint_background_color(row.waypoint.waypoint_type)};"
          ]
            td[colspan="4"]
              .d-flex.justify-content-between.align-items-center
                span
                  i.bi.me-2[class=waypoint_type_icon(row.waypoint.waypoint_type) style="color: #{waypoint_color(row.waypoint.waypoint_type)};"]
                  strong
                    = link_to(row.waypoint.name, trip_waypoint_path(trip, row.waypoint), class: "text-decoration-none text-reset", data: { turbo: false }, onclick: "event.stopPropagation()")
                  - unless row.first?
                    = arriving_profile_badge(row.arriving_profile)
                .d-flex.align-items-center.gap-2
                  - if row.arrival_time
                    small.text-muted.fw-normal = row.arrival_time
                  i.bi.bi-chevron-down.text-muted.small[style="transition: transform 0.2s;"]

        - if row.next_is_transit?
          tbody.collapse[id=segment_id]
            tr
              td.text-center.text-muted.py-3[colspan="4"]
                i.bi.bi-train-front.me-2
                = t('routes.show.transit_no_directions')

        - elsif row.steps.any?
          tbody.collapse[id=segment_id class=row.segment_class]
            - row.steps.each do |step|
              tr.direction-step[
                data-directions-target="step"
                data-action="click->directions#showOnMap"
                data-lat=step.lat
                data-lng=step.lon
                data-instruction=step.instruction
                style="cursor: pointer;"
              ]
                td
                  small = step.instruction
                td.text-end.text-nowrap
                  small = format_distance(step.distance, decimals: 2)
                td.text-end.text-nowrap
                  - if step.speed
                    small = format_speed(step.speed)
                td.text-end.text-nowrap
                  - if step.time
                    small = step.time
                  - else
                    small.text-muted —

  - else
    .p-4.text-center
      i.bi.bi-map.text-muted.fs-1.d-block.mb-3
      p.text-muted.mb-0 = t('routes.show.no_route_calculated')
