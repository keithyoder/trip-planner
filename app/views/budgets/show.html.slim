/ app/views/budgets/show.html.slim

- total = @budget.total
- percentages = @budget.category_percentages
- current_currency = @budget.currency.to_s.upcase

.container-fluid.py-4
  .row.mb-4.align-items-center
    .col
      h1.h3.fw-light
        | #{@trip.name}
        span.text-muted.ms-2.fs-6 = t('budget.title')

    / Currency selector
    .col-auto
      form.d-flex.align-items-center.gap-2 method="get"
        label.small.text-muted.mb-0 for="currency"
          = t('budget.select_currency')
        select.form-select.form-select-sm name="currency" id="currency" onchange="this.form.submit()"
          - %w[BRL USD ARS UYU CLP BOB PEN].each do |code|
            option value=code.downcase selected=(code == current_currency ? 'selected' : nil)
              = code

  / Summary cards
  .row.g-3.mb-4
    .col-6.col-md-3
      .card.border-0.bg-light.h-100
        .card-body
          .small.text-muted.text-uppercase.fw-semibold.mb-1 Total
          .fs-4.fw-bold = total.format

    - @budget.by_category.sort_by { |_, v| -v.fractional }.each do |category, amount|
      .col-6.col-md-3
        .card.border-0.bg-light.h-100
          .card-body
            .small.text-muted.text-uppercase.fw-semibold.mb-1
              = t("budget.categories.#{category}")
            .fs-5.fw-semibold = amount.format
            .progress.mt-2.bg-white style="height: 4px"
              .progress-bar style="width: #{percentages[category]}%" role="progressbar"

  / Category breakdown with collapsible line items
  .card.border-0.shadow-sm
    .card-header.bg-white.border-bottom.py-3
      h2.h6.mb-0.text-uppercase.fw-semibold.text-muted = t('budget.detail_heading')

    .list-group.list-group-flush
      - @budget.by_category.sort_by { |_, v| -v.fractional }.each do |category, amount|
        - items = @budget.items_for(category)
        - collapse_id = "category-#{category}"

        .list-group-item.px-4
          / Category row — clickable to expand (all collapsed by default)
          a.d-flex.align-items-center.text-decoration-none.text-dark.py-2 href="##{collapse_id}" data-bs-toggle="collapse" aria-expanded="false" aria-controls="#{collapse_id}"
            span.me-2.text-muted
              i.bi.bi-chevron-down.collapse-chevron

            span.flex-grow-1.fw-medium
              = t("budget.categories.#{category}")

            span.badge.bg-secondary.rounded-pill.me-3.fw-normal
              = t('budget.items_count', count: items.size)

            span.fw-semibold = amount.format

            - pct = percentages[category]
            span.text-muted.small.ms-3.text-end style="min-width: 3.5rem"
              = "#{pct}%"

          / Line items — collapsed by default
          div id=collapse_id class="collapse"
            table.table.table-sm.table-borderless.mb-0.mt-1
              thead
                tr.text-muted.small.text-uppercase
                  th.ps-0 = t('budget.columns.description')
                  th = t('budget.columns.country')
                  th.text-end = t('budget.columns.local_amount')
                  th.text-end = t('budget.columns.amount', currency: current_currency)
              tbody
                - items.each do |item|
                  - wp = item.waypoint
                  tr
                    td.ps-0
                      / Translated waypoint type
                      span.text-muted.small.me-1
                        = t("waypoint.#{wp.waypoint_type}", default: wp.waypoint_type&.humanize)
                      / Linked waypoint name
                      = link_to wp.name, trip_waypoint_path(@trip, wp), class: 'text-decoration-none'
                    td.text-muted.small = item.country
                    td.text-end.text-muted.small = item.amount.format
                    td.text-end.fw-medium = item.amount.exchange_to(@budget.currency).format
              tfoot
                tr.border-top
                  td.ps-0.fw-semibold.text-end colspan="3" = t('budget.subtotal')
                  td.text-end.fw-semibold = amount.format

  / Footer: currency note
  .text-muted.small.mt-3.text-end
    = t('budget.currency_note', currency: current_currency)
