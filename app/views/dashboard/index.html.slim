/ Full screen map container
#dashboard-container style="height: 100dvh; width: 100vw; position: relative; overflow: hidden;"
  / Map takes full screen - marked as permanent so Turbo doesn't touch it
  #map style="height: 100%; width: 100%;" data-turbo-permanent="true"
  
  / Top left header overlay
  .dashboard-header
    h1.display-6.fw-bold.mb-0
      i.bi.bi-speedometer2.me-2
      | Live Telemetry
    p.mb-0.small
      span#last-update-text Loading...

  / Left side widgets partial (no initial data)
  = render 'left_widgets'

  / Right side weather sidebar (no initial data)
  = render 'sidebar'

/ Map initialization
javascript:
  let wasHidden = false;
  window.currentTripPoints = [];

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      // Mark that the page was hidden
      wasHidden = true;
    } else if (wasHidden) {
      // Page is visible again after being hidden - fetch latest data
      console.log('Dashboard was backgrounded, fetching latest data...');
      wasHidden = false;
      if (window.dashboardDataFetcher) {
        window.dashboardDataFetcher.fetchDashboardData().then(data => {
          if (data) {
            window.dashboardDataFetcher.updateDashboard(data);
          }
        });
      }
    }
  });

  (function() {
    // Check if map already exists
    if (window.dashboardMap) {
      return;
    }
    
    function initMap() {
      var mapElement = document.getElementById('map');
      if (!mapElement) return;
      
      // Initialize map with default view (will be updated when data loads)
      window.dashboardMap = L.map('map', {
        zoomControl: false
      }).setView([0, 0], 2); // Default world view
      
      L.control.zoom({
        position: 'bottomright'
      }).addTo(window.dashboardMap);
      
      L.tileLayer(
        'https://tiles.stadiamaps.com/tiles/outdoors/{z}/{x}/{y}.png?api_key=50e54c7f-f220-44f9-875c-a0ce16bc63b5',
        {
          maxZoom: 19,
          attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }
      ).addTo(window.dashboardMap);
      
      // Trip routes layer
      window.tripRoutesLayer = L.layerGroup().addTo(window.dashboardMap);
      
      // Sidebar toggle functionality
      var toggle = document.getElementById('sidebar-toggle');
      var sidebar = document.getElementById('weather-sidebar');
      
      if (toggle && sidebar) {
        toggle.addEventListener('click', function() {
          sidebar.classList.toggle('open');
          toggle.classList.toggle('open');
        });
      }

      // Mark map as initialized
      window.mapInitialized = true;
      
      // If data fetcher has already loaded data, update the map
      if (window.initialDashboardData) {
        updateMapWithData(window.initialDashboardData);
      }
    }
    
    // Function to update map with loaded data
    window.updateMapWithData = function(data) {
      if (!window.dashboardMap || !data || !data.gps) return;
      
      var gps = data.gps;
      
      // Update map view to current location
      window.dashboardMap.setView([gps.lat, gps.lon], 17);
      
      // Create/update current location marker
      if (!window.currentMarker) {
        const carIcon = L.divIcon({
          html: '<div class="car-icon-container"><img src="#{asset_path('car-icon.svg')}" alt="car" /></div>',
          className: 'car-marker',
          iconSize: [32, 32],
          iconAnchor: [16, 16],
          popupAnchor: [0, -16]
        });

        window.currentMarker = L.marker(
          [gps.lat, gps.lon], 
          {icon: carIcon, rotationAngle: 0}
        ).addTo(window.dashboardMap);
        
        window.currentMarker.bindPopup(`
          <strong>Current Location</strong><br>
          Temp: ${data.temperature || '--'}°C<br>
          Speed: ${data.speed_kmh || 0} km/h
        `);
      } else {
        window.currentMarker.setLatLng([gps.lat, gps.lon]);
      }
      
      // Store current heading
      window.currentHeading = gps.heading || 0;
      
      // Rotate car icon if heading available
      if (gps.heading && window.dashboardChannel) {
        window.dashboardChannel.rotateCarIcon(gps.heading);
      }
      
      // Update trip points if available
      if (data.trip_points && data.trip_points.length > 0) {
        window.currentTripPoints = data.trip_points;
        if (window.dashboardChannel) {
          window.dashboardChannel.updateTripPolyline();
        }
      }
            
      // Update last update text
      updateLastUpdateText(data.timestamp);
    }
        
    function updateLastUpdateText(timestamp) {
      const element = document.getElementById('last-update-text');
      if (!element || !timestamp) return;
      
      const date = new Date(timestamp);
      const now = new Date();
      const secondsAgo = Math.floor((now - date) / 1000);
      
      let timeText;
      if (secondsAgo < 60) {
        timeText = 'Just now';
      } else if (secondsAgo < 3600) {
        const minutes = Math.floor(secondsAgo / 60);
        timeText = `${minutes} minute${minutes !== 1 ? 's' : ''} ago`;
      } else {
        const hours = Math.floor(secondsAgo / 3600);
        timeText = `${hours} hour${hours !== 1 ? 's' : ''} ago`;
      }
      
      element.textContent = `Last update: ${timeText}`;
    }
    
    // Initialize on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }
    
    // Handle Turbo navigation
    document.addEventListener('turbo:load', function() {
      if (!window.dashboardMap) {
        initMap();
      }
    });
    
    // Cleanup on navigation away
    document.addEventListener('turbo:before-cache', function() {
      if (window.dashboardMap) {
        window.dashboardMap.remove();
        window.dashboardMap = null;
        window.tripRoutesLayer = null;
        window.currentMarker = null;
        window.mapInitialized = false;
      }
    });
  })();

meta name="turbo-refresh-method" content="morph"
meta name="turbo-refresh-scroll" content="preserve"
