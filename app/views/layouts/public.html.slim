doctype html
html lang=public_html_lang
  head
    meta charset="utf-8"
    - description = content_for?(:description) ? yield(:description) : t('landing.meta_description')
    title = content_for?(:title) ? yield(:title) : t('landing.brand')
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="description" content=description
    meta name="theme-color" content="#141414"
    meta property="og:type" content="website"
    meta property="og:title" content=t('landing.brand')
    meta property="og:description" content=description
    meta property="og:image" content=image_url('landing/patch-560.png')
    = csrf_meta_tags
    = csp_meta_tag
    = favicon_link_tag 'landing/avatar-128.png', type: 'image/png'
    = stylesheet_link_tag 'public'
  body
    .page
      = render 'public/stripe'
      = render 'public/header'
      = yield
