/ app/views/trips/currencies.html.slim

.container.mt-4
  .row
    .col
      .d-flex.justify-content-between.align-items-center.mb-4
        h1 = t('.title', trip_name: @trip.name)
        = link_to t('.back_to_trip'), trip_path(@trip), class: 'btn btn-outline-primary'
      
      - if @exchange_rates.empty?
        .alert.alert-info
          = t('.no_countries')
      - else
        .card
          .card-header
            h5.mb-0 
              = t('.exchange_rates_header', default_currency: Money::Currency.new(@default_currency).name)
          .card-body
            table.table.table-striped.table-hover
              thead
                tr
                  th = t('.country')
                  th = t('.currency')
                  th.text-end = t('.exchange_rate')
                  th.text-end = t('.inverse_rate')
              tbody
                - @exchange_rates.each do |rate|
                  tr
                    td 
                      strong = rate[:country]
                    td
                      = rate[:currency].upcase
                      small.text-muted.ms-2 = Money::Currency.new(rate[:currency]).name
                    td.text-end
                      code = rate[:formatted_rate]
                    td.text-end
                      code = rate[:formatted_inverse_rate]
            
            .mt-3
              small.text-muted 
                - if @rates_updated_at
                  = t('.rates_updated', updated_at: l(@rates_updated_at, format: :long))
                - else
                  = t('.rates_not_updated')
