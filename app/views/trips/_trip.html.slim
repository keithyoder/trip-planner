div[id=dom_id(trip)]
  .row.g-3
    .col-md-6
      .info-item
        small.text-muted.d-block.mb-1
          i.bi.bi-tag.me-1
          = t('trips.show.trip_name')
        p.mb-0.fw-semibold = trip.name
    
    .col-md-6
      .info-item
        small.text-muted.d-block.mb-1
          i.bi.bi-calendar-event.me-1
          = t('trips.show.start_date')
        p.mb-0.fw-semibold = trip.start_on ? l(trip.start_on, format: :long) : t('trips.show.not_set')
    
    .col-md-6
      .info-item
        small.text-muted.d-block.mb-1
          i.bi.bi-sign-turn-right.me-1
          = t('trips.show.distance')
        p.mb-0.fw-semibold = trip.distance.default.to_s(units: true, decimals: 0) || t('trips.show.not_available')
    
    .col-md-6
      .info-item
        small.text-muted.d-block.mb-1
          i.bi.bi-hourglass-split.me-1
          = t('trips.show.duration')
        p.mb-0.fw-semibold = trip.duration_days ? "#{trip.duration_days.to_i} #{t('trips.index.day', count: trip.duration_days)}" : t('trips.show.not_available')