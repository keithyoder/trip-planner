.container-fluid.py-4
  - if notice
    .alert.alert-success.alert-dismissible.fade.show role="alert"
      = notice
      button.btn-close type="button" data-bs-dismiss="alert"
  
  .row.mb-4
    .col-12
      .d-flex.justify-content-between.align-items-center
        div
          h1.display-5.fw-bold.mb-1
            i.bi.bi-suitcase-lg.me-2
            = t('trips.index.my_trips')
          p.text-muted.mb-0 = t('trips.index.plan_and_manage')
        = link_to new_trip_path, class: "btn btn-primary btn-lg" do
          i.bi.bi-plus-circle.me-2
          = t('trips.index.new_trip')
  
  - if @trips.any?
    .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
      - @trips.each do |trip|
        .col
          .card.shadow-sm.h-100.trip-card
            .card-header.bg-white.border-bottom
              .d-flex.justify-content-between.align-items-center.gap-2
                h5.card-title.mb-0.text-truncate
                  = link_to trip, class: "text-decoration-none text-dark" do
                    i.bi.bi-map.me-2
                    = trip.name
                span.flex-shrink-0 = status_badge(trip.status)
            .card-body
              .row.g-2.mb-3
                .col-6
                  small.text-muted.d-block
                    i.bi.bi-calendar-event.me-1
                    = t('trips.index.start_date')
                  strong.d-block = trip.start_on&.strftime("%b %d, %Y") || t('trips.index.not_set')
                .col-6
                  small.text-muted.d-block
                    i.bi.bi-sign-turn-right.me-1
                    = t('trips.index.distance')
                  strong.d-block = trip.distance ? format_distance(trip.distance, decimals: 0) : t('trips.index.not_available')
              - if trip.duration_days
                .mb-2
                  small.text-muted
                    i.bi.bi-hourglass-split.me-1
                    = t('trips.index.duration')
                  strong<> = "#{trip.duration_days.to_i} #{t('trips.index.day', count: trip.duration_days)}"
            .card-footer.bg-white.border-top
              .d-flex.gap-2
                = link_to trip, class: "btn btn-sm btn-outline-primary flex-fill" do
                  i.bi.bi-eye.me-1
                  = t('trips.index.view')
                = link_to edit_trip_path(trip), class: "btn btn-sm btn-outline-secondary" do
                  i.bi.bi-pencil
                = button_to trip, method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t('trips.index.delete_confirm') } } do
                  i.bi.bi-trash
  - else
    .row
      .col-12
        .card.shadow-sm.text-center.py-5
          .card-body
            i.bi.bi-suitcase.text-muted style="font-size: 4rem;"
            h3.mt-3.mb-2 = t('trips.index.no_trips')
            p.text-muted.mb-4 = t('trips.index.start_planning')
            = link_to new_trip_path, class: "btn btn-primary btn-lg" do
              i.bi.bi-plus-circle.me-2
              = t('trips.index.create_first_trip')