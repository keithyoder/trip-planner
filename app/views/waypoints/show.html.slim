.container-fluid.py-4
  / Flash notice
  - if notice
    .alert.alert-success.alert-dismissible.fade.show role="alert"
      = notice
      button.btn-close type="button" data-bs-dismiss="alert" aria-label="Close"
  
  .row
    .col-12
      / Waypoint header with title and actions
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h1.display-5.fw-bold.mb-1 = @waypoint.name || "Waypoint Details"
          p.text-muted.mb-0
            = @waypoint.waypoint_type.to_s.titleize
            |  - Sequence #{@waypoint.sequence}
        
        .btn-group role="group"
          = link_to edit_trip_waypoint_path(@trip, @waypoint), class: "btn btn-outline-primary" do
            i.bi.bi-pencil-square.me-2
            | Edit
          = link_to @waypoint.route ? trip_route_path(@trip, @waypoint.route) : trip_waypoints_path(@trip), class: "btn btn-outline-secondary" do
            i.bi.bi-arrow-left.me-2
            | Back
  
  .row.g-4
    / Map section - takes full width on mobile, 8 cols on larger screens
    .col-lg-8
      .card.shadow-sm.h-100
        .card-header.bg-white.border-bottom
          h5.card-title.mb-0
            i.bi.bi-map.me-2
            | Location
        .card-body.p-0
          div[data-controller="maps"]
            #mycontainer[
              data-maps-target="container" 
              class="w-100"
              style="min-height: 500px; height: 60vh;" 
              data-lon="#{@waypoint.lonlat.x}" 
              data-lat="#{@waypoint.lonlat.y}"
              data-waypoint-type="#{@waypoint.waypoint_type}"
              data-waypoint-name="#{@waypoint.name}"
            ]
    
    / Waypoint details sidebar
    .col-lg-4
      .card.shadow-sm.mb-4
        .card-header.bg-white.border-bottom
          h5.card-title.mb-0
            i.bi.bi-info-circle.me-2
            | Waypoint Information
        .card-body
          = render @waypoint
          
          / Delay information
          - if @waypoint.delay && @waypoint.delay > 0
            .mt-3.pt-3.border-top
              .d-flex.justify-content-between.align-items-center
                span.text-muted
                  i.bi.bi-clock.me-2
                  | Delay Duration
                - hours = (@waypoint.delay / 3600).to_i
                - minutes = ((@waypoint.delay % 3600) / 60).to_i
                strong.fs-5
                  - if hours > 0 && minutes > 0
                    = "#{hours} #{t('common.hour', count: hours)} #{t('common.and')} #{minutes} #{t('common.minute', count: minutes)}"
                  - elsif hours > 0
                    = "#{hours} #{t('common.hour', count: hours)}"
                  - else
                    = "#{minutes} #{t('common.minute', count: minutes)}"
          
          / Toll/Cost information
          - if @waypoint.toll && @waypoint.toll > 0
            .mt-3.pt-3.border-top
              .d-flex.justify-content-between.align-items-center
                span.text-muted
                  i.bi.bi-cash-coin.me-2
                  | Toll / Cost
                strong.text-success.fs-5 = format_currency(@waypoint)

      / Notes
      - if @waypoint.notes.present?
        .card.shadow-sm.mb-4
          .card-header.bg-white.border-bottom
            .d-flex.justify-content-between.align-items-center
              h5.card-title.mb-0
                i.bi.bi-journal-text.me-2
                | Notes
              - if @waypoint.notes.keys.length > 1
                ul.nav.nav-tabs.card-header-tabs.mb-0 role="tablist"
                  - @waypoint.notes.each_with_index do |(locale, content), index|
                    - next if content.blank?
                    li.nav-item role="presentation"
                      button.nav-link[
                        class=("active" if index.zero?)
                        data-bs-toggle="tab"
                        data-bs-target="#show-notes-pane-#{locale}"
                        type="button"
                        role="tab"
                      ]
                        = locale.upcase
          .card-body
            - if @waypoint.notes.keys.length > 1
              .tab-content
                - @waypoint.notes.each_with_index do |(locale, content), index|
                  - next if content.blank?
                  .tab-pane.fade[
                    class=("show active" if index.zero?)
                    id="show-notes-pane-#{locale}"
                    role="tabpanel"
                  ]
                    .markdown-preview = @waypoint.rendered_notes(locale)
            - else
              .markdown-preview = @waypoint.rendered_notes
      
      = render 'weather', waypoint: @waypoint
      = render 'weather_hourly_chart', waypoint: @waypoint

      / Danger zone for delete action
      .card.shadow-sm.danger-zone-card
        .card-header.border-bottom
          h5.card-title.mb-0.text-danger
            i.bi.bi-exclamation-triangle.me-2
            | Danger Zone
        .card-body
          p.text-muted.mb-3.small Deleting this waypoint is permanent and cannot be undone.
          = button_to [@trip, @waypoint], method: :delete, class: "btn btn-danger w-100", form: { data: { turbo_confirm: "Are you sure you want to delete this waypoint?" } } do
            i.bi.bi-trash.me-2
            | Delete Waypoint