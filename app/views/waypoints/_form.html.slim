= form_with(model: [@trip, waypoint], class: "needs-validation", local: true) do |form|
  - if waypoint.errors.any?
    .alert.alert-danger.alert-dismissible.fade.show[role="alert"]
      .d-flex.align-items-start
        i.bi.bi-exclamation-triangle-fill.me-3.fs-4
        div
          h5.alert-heading.mb-2
            = pluralize(waypoint.errors.count, "error")
            |  prohibited this waypoint from being saved:
          ul.mb-0.ps-3
            - waypoint.errors.each do |error|
              li
                = error.full_message
      button.btn-close[type="button" data-bs-dismiss="alert" aria-label="Close"]
  
  / Name field
  .mb-4
    = form.label :name, class: "form-label fw-semibold" do
      i.bi.bi-tag.me-2
      = t('waypoints.form.name_label')
    = form.text_field :name, class: "form-control form-control-lg", placeholder: t('waypoints.form.name_placeholder')
    .form-text = t('waypoints.form.name_hint')

  / Sequence field
  .mb-4
    = form.label :sequence, class: "form-label fw-semibold" do
      i.bi.bi-arrow-down-up.me-2
      = t('waypoints.form.sequence_label')
    = form.number_field :sequence, class: "form-control form-control-lg", placeholder: "0"
    .form-text = t('waypoints.form.sequence_hint')

  / Waypoint type
  .mb-4
    = form.label :waypoint_type, class: "form-label fw-semibold" do
      i.bi.bi-signpost-split.me-2
      = t('waypoints.form.waypoint_type_label')
    = form.select :waypoint_type, options_for_select(Waypoint.waypoint_types.map { |key, value| [key.humanize, Waypoint.waypoint_types.key(value)]}, waypoint.waypoint_type), { include_blank: false }, class: "form-select form-select-lg"
    .form-text = t('waypoints.form.waypoint_type_hint')

  / Transport profile
  .mb-4
    = form.label :profile, class: "form-label fw-semibold" do
      i.bi.bi-person-walking.me-2
      = t('waypoints.form.profile_label')
    - profile_options = Waypoint::PROFILES.map { |k| [I18n.t("waypoints.profiles.#{k}"), k] }
    = form.select :profile,
        options_for_select(profile_options, waypoint.profile || 'driving-car'),
        { include_blank: false },
        class: "form-select form-select-lg"
    .form-text = t('waypoints.form.profile_hint')

  / Location field
  .mb-4
    = form.label :latlon, class: "form-label fw-semibold" do
      i.bi.bi-geo.me-2
      = t('waypoints.form.location_label')
    = form.text_field :latlon, class: "form-control form-control-lg", placeholder: t('waypoints.form.location_hint')

  / Delay field
  .mb-4
    = form.label :delay, class: "form-label fw-semibold" do
      i.bi.bi-clock.me-2
      = t('waypoints.form.delay_label')
    - delay_hours = waypoint.delay ? (waypoint.delay / 3600).to_i : 0
    - delay_minutes = waypoint.delay ? ((waypoint.delay % 3600) / 60).to_i : 0
    .row.g-2
      .col-6
        .input-group.input-group-lg
          = form.number_field :delay_hours, value: delay_hours, class: "form-control", placeholder: "0", min: "0"
          span.input-group-text = t('waypoints.form.hours')
      .col-6
        .input-group.input-group-lg
          = form.number_field :delay_minutes, value: delay_minutes, class: "form-control", placeholder: "0", min: "0", max: "59"
          span.input-group-text = t('waypoints.form.minutes')
    .form-text = t('waypoints.form.delay_hint')

  / Toll field
  .mb-4
    = form.label :toll, class: "form-label fw-semibold" do
      i.bi.bi-cash-coin.me-2
      = t('waypoints.form.toll_label')
    .input-group.input-group-lg
      span.input-group-text $
      = form.number_field :toll, class: "form-control", placeholder: "0.00", step: "0.01"
    .form-text = t('waypoints.form.toll_hint')

  / Notes field
  .mb-4
    label.form-label.fw-semibold
      i.bi.bi-journal-text.me-2
      = t('waypoints.form.notes_label')
    .card[data-controller="waypoint-notes"]
      .card-header.p-0
        ul.nav.nav-tabs.card-header-tabs.px-2.pt-2 role="tablist"
          - %w[en es pt].each_with_index do |locale, index|
            li.nav-item role="presentation"
              button.nav-link[
                class=("active" if index.zero?)
                id="notes-tab-#{locale}"
                data-bs-toggle="tab"
                data-bs-target="#notes-pane-#{locale}"
                type="button"
                role="tab"
              ]
                = locale.upcase
      .card-body
        .tab-content
          - %w[en es pt].each_with_index do |locale, index|
            .tab-pane.fade[
              class=("show active" if index.zero?)
              id="notes-pane-#{locale}"
              role="tabpanel"
            ]
              .row.g-0
                .col-6.pe-2
                  label.form-label.small.text-muted
                    i.bi.bi-pencil.me-1
                    = t('waypoints.form.notes_markdown')
                  = form.text_area "notes[#{locale}]",
                      name: "waypoint[notes][#{locale}]",
                      value: waypoint.notes&.dig(locale),
                      class: "form-control font-monospace",
                      rows: 8,
                      placeholder: t('waypoints.form.notes_placeholder', lang: locale.upcase),
                      data: { action: "input->waypoint-notes#preview", locale: locale }
                .col-6.ps-2
                  label.form-label.small.text-muted
                    i.bi.bi-eye.me-1
                    = t('waypoints.form.notes_preview')
                  .border.rounded.p-3.bg-light.markdown-preview[
                    style="min-height: 190px;"
                    data-waypoint-notes-target="preview"
                    data-locale=locale
                  ]
                    - if waypoint.notes&.dig(locale).present?
                      = waypoint.rendered_notes(locale)
    .form-text = t('waypoints.form.notes_hint')

  / Submit button
  .d-grid.gap-2.d-md-flex.justify-content-md-end.mt-4.pt-3.border-top
    = link_to t('common.cancel'), trip_waypoints_path(@trip), class: "btn btn-lg btn-outline-secondary"
    = form.submit t('waypoints.form.save'), class: "btn btn-lg btn-primary px-5"