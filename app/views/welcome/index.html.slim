- content_for :title, t('landing.brand')
- content_for :header_actions do
  - if user_signed_in?
    = link_to t('landing.open_app'), trips_path, class: 'btn btn-primary btn-sm', data: { turbo: false }
  - else
    = link_to t('landing.login'), new_user_session_path, class: 'btn btn-primary btn-sm'

main#inicio
  section.hero.wrap aria-labelledby="hero-title"
    .hero-patch
      = image_tag 'landing/patch-560.png', class: 'patch', width: 280, height: 280, alt: t('landing.patch_alt')
    .hero-text
      - date = l(@overview.start_on, format: :landing)
      p.eyebrow = t('landing.dates', date: date)
      h1#hero-title.hero-title = t('landing.headline')
      p.lead = t('landing.description', date: date)
      = render 'welcome/stats', overview: @overview
    = render 'welcome/map', overview: @overview, map: @map
  = render 'welcome/follow'

= render 'public/horizon'
= render 'welcome/footer'
